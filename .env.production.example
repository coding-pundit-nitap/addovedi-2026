# Copy this file to ".env" in the repo root and fill in real values.
# docker-compose reads ".env" here automatically.

# --- Database ---
# Leave MONGODB_URI commented out to use the bundled MongoDB container (data lives in the
# "mongo_data" volume, starts empty, no auth: it is only reachable inside the compose network).
# To use an external database instead (e.g. the existing MongoDB Atlas cluster, so the college
# server serves the same data as Render), set the full connection string here:
#   - Atlas: Network Access must allow this server's public IP.
#   - URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
#   - Do not wrap it in quotes; a literal $ must be written as $$ (compose treats $ as a variable).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/addovedi?retryWrites=true&w=majority

# --- Backend secrets ---
JWT_SECRET=replace_with_a_long_random_string
# Password for the seeded "admin" account, used only the very first time
# the server starts against an empty database.
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password

# Comma-separated list of origins allowed to call the API directly. Not
# needed for the browser traffic (the top-level nginx/ proxies /api/* so
# those calls are same-origin), but keep it accurate for direct API access
# / future use. List every address people open the site at (with https://, no
# trailing slash). Requests from the same host the site is served on are also
# accepted automatically; anything else gets "403 Origin not allowed".
ALLOWED_ORIGINS=https://www.addovedi.nitap.ac.in,https://addovedi.nitap.ac.in

# --- Cloudinary (admin image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare Turnstile (signup CAPTCHA) ---
# Server-side secret key (from the Turnstile dashboard).
TURNSTILE_SECRET_KEY=
# Public site key, baked into the frontend build at build time.
VITE_TURNSTILE_SITE_KEY=

# --- Port on the host machine (only nginx/ is published) ---
NGINX_PORT=8080
