# Copy this file to ".env" in the repo root and fill in real values.
# docker-compose reads ".env" here automatically.

# --- Backend secrets ---
JWT_SECRET=replace_with_a_long_random_string
# Password for the seeded "admin" account, used only the very first time
# the server starts against an empty database.
ADMIN_INITIAL_PASSWORD=replace_with_a_strong_password

# Comma-separated list of origins allowed to call the API directly. Not
# needed for the browser traffic (the top-level nginx/ proxies /api/* so
# those calls are same-origin), but keep it accurate for direct API access
# / future use. Example: http://your-college-server:8080
ALLOWED_ORIGINS=http://localhost:8080

# --- Cloudinary (admin image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare Turnstile (signup CAPTCHA) ---
# Server-side secret key (from the Turnstile dashboard).
TURNSTILE_SECRET_KEY=
# Public site key, baked into the frontend build at build time.
VITE_TURNSTILE_SITE_KEY=

# --- Port on the host machine (only nginx/ is published) ---
NGINX_PORT=8080
